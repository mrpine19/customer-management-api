# Customer Management API - Test Suite
#
# This file contains a comprehensive set of requests to test all functionalities
# of the Customer Management API.
#
# Variables:
# - host: The base URL of the application.
# - admin_user / admin_pass: Credentials for the ADMIN role.
# - user_user / user_pass: Credentials for the USER role.
# - createdCustomerId: Stores the ID of a newly created customer for subsequent requests.
# - customerToDeleteId: Set manually to the ID of the customer to be deleted (from data.sql).

###
# ==============================================================================
# == Environment Variables
# ==============================================================================
@host = http://localhost:8080
@admin_user = admin
@admin_pass = admin123
@user_user = user
@user_pass = user123

# Set this to the ID of "Cliente a Deletar" from data.sql (usually 7)
@customerToDeleteId = 7

###
# ==============================================================================
# == 1. USER Role: Read-Only Operations
# ==============================================================================

### 1.1 (USER) List all customers
# Description: Should return a list of all customers from data.sql.
# Expected: 200 OK
GET {{host}}/customers
Authorization: Basic {{user_user}} {{user_pass}}

### 1.2 (USER) Filter customers by status 'ACTIVE'
# Description: Should return only the active customers.
# Expected: 200 OK
GET {{host}}/customers?status=ACTIVE
Authorization: Basic {{user_user}} {{user_pass}}

### 1.3 (USER) Search for customers by name
# Description: Should find customers whose name contains 'Silva'.
# Expected: 200 OK
GET {{host}}/customers/search?name=Silva
Authorization: Basic {{user_user}} {{user_pass}}

### 1.4 (USER) Get a specific customer by ID
# Description: Fetches the customer with ID 1.
# Expected: 200 OK
GET {{host}}/customers/1
Authorization: Basic {{user_user}} {{user_pass}}

### 1.5 (USER) Attempt to create a customer (Permission Test)
# Description: Should fail because the USER role cannot create customers.
# Expected: 403 Forbidden
POST {{host}}/customers
Content-Type: application/json
Authorization: Basic {{user_user}} {{user_pass}}

{
  "name": "Test User Role",
  "cpf": "12312312312",
  "email": "test.user@example.com",
  "status": "ACTIVE",
  "birthDate": "2000-01-01"
}

###
# ==============================================================================
# == 2. ADMIN Role: Full CRUD and Validation Tests
# ==============================================================================

### 2.1 (ADMIN) Create a new customer successfully
# @name createCustomer
# Description: Creates a new customer and captures its ID.
# Expected: 201 Created
POST {{host}}/customers
Content-Type: application/json
Authorization: Basic {{admin_user}} {{admin_pass}}

{
  "name": "Beatriz Oliveira",
  "cpf": "88877766655",
  "email": "beatriz.oliveira@example.com",
  "phone": "21987654321",
  "status": "ACTIVE",
  "birthDate": "1998-11-10"
}

### 2.2 (ADMIN) Get the newly created customer by its captured ID
@createdCustomerId = 8
# Description: Verifies that the customer was created correctly.
# Expected: 200 OK
GET {{host}}/customers/{{createdCustomerId}}
Authorization: Basic {{admin_user}} {{admin_pass}}

### 2.3 (ADMIN) Attempt to create a customer with a duplicate CPF
# Description: Should fail because the CPF from customer with ID 1 already exists.
# Expected: 409 Conflict
POST {{host}}/customers
Content-Type: application/json
Authorization: Basic {{admin_user}} {{admin_pass}}

{
  "name": "Duplicate CPF Test",
  "cpf": "12345678901",
  "email": "duplicate.cpf@example.com",
  "phone": "21987654321",
  "status": "ACTIVE",
  "birthDate": "1999-01-01"
}

### 2.4 (ADMIN) Update the newly created customer
# Description: Updates the name and status of the customer created in step 2.1.
# Expected: 200 OK
PUT {{host}}/customers/{{createdCustomerId}}
Content-Type: application/json
Authorization: Basic {{admin_user}} {{admin_pass}}

{
  "name": "Beatriz Oliveira (Updated)",
  "cpf": "88877766655",
  "email": "beatriz.oliveira.updated@example.com",
  "phone": "21999999999",
  "status": "INACTIVE",
  "birthDate": "1998-11-10"
}

### 2.5 (ADMIN) Delete a pre-existing customer
# Description: Deletes the customer with the ID set in the @customerToDeleteId variable.
# Expected: 204 No Content
DELETE {{host}}/customers/{{customerToDeleteId}}
Authorization: Basic {{admin_user}} {{admin_pass}}

### 2.6 (ADMIN) Verify deletion of the pre-existing customer
# Description: Attempting to fetch the deleted customer should fail.
# Expected: 404 Not Found
GET {{host}}/customers/{{customerToDeleteId}}
Authorization: Basic {{admin_user}} {{admin_pass}}

###
# ==============================================================================
# == 3. Score Service Integration Tests (WireMock Scenarios)
# ==============================================================================
# Note: These tests require the WireMock container to be running as specified in the README.

### 3.1 (SCORE) Success Case
# Description: Customer ID 1 (CPF 12345678901) should return a score successfully.
# Expected: 200 OK
GET {{host}}/customers/1/score
Authorization: Basic {{user_user}} {{user_pass}}

### 3.2 (SCORE) Not Found Case
# Description: Customer ID 2 (CPF 98765432100) is not found in the score service.
# Expected: 404 Not Found
GET {{host}}/customers/2/score
Authorization: Basic {{user_user}} {{user_pass}}

### 3.3 (SCORE) Server Error Case
# Description: Customer ID 4 (CPF 11122233344) causes a 500 error in the score service.
# Expected: 503 Service Unavailable (or similar, depending on your handler)
GET {{host}}/customers/4/score
Authorization: Basic {{user_user}} {{user_pass}}

### 3.4 (SCORE) Timeout Case
# Description: Customer ID 6 (CPF 55566677788) simulates a long delay.
# Expected: 504 Gateway Timeout
GET {{host}}/customers/6/score
Authorization: Basic {{user_user}} {{user_pass}}

### 3.5 (SCORE) Invalid Body Case
# Description: Customer ID 5 (CPF 99988877766) returns a malformed JSON.
# Expected: 502 Bad Gateway (or similar, depending on your handler)
GET {{host}}/customers/5/score
Authorization: Basic {{user_user}} {{user_pass}}

###
# ==============================================================================
# == 4. Unauthenticated Access Tests
# ==============================================================================

### 4.1 (UNAUTHENTICATED) Attempt to list customers
# Description: Should fail because authentication is required.
# Expected: 401 Unauthorized
GET {{host}}/customers

### 4.2 (UNAUTHENTICATED) Attempt to get a specific customer
# Description: Should fail because authentication is required.
# Expected: 401 Unauthorized
GET {{host}}/customers/1
